[node name="howtodissolve" type="RichTextLabel" parent="." unique_id=1024989551]
visible = false
offset_left = 24.0
offset_top = 24.0
offset_right = 1128.0
offset_bottom = 624.0
theme_override_colors/default_color = Color(0.6750817, 0.1732086, 0.5709119, 1)
theme_override_font_sizes/normal_font_size = 32
theme_override_styles/normal = SubResource("StyleBoxFlat_fycrg")
text = "How to dissolve a solute using a volumetric flask:

1.) Get solute (convert moles to grams)
2.) Pour water up to half the flask
3.) Add solid
4.) Swirl the flask
5.) Pour water up to calibration marker
6.) Shake the flask"
horizontal_alignment = 1
vertical_alignment = 1

