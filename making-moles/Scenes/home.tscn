[node name="howconvert" type="RichTextLabel" parent="." unique_id=585198750]
visible = false
offset_left = 24.0
offset_top = 24.0
offset_right = 1128.0
offset_bottom = 624.0
theme_override_colors/default_color = Color(0.6750817, 0.1732086, 0.5709119, 1)
theme_override_font_sizes/normal_font_size = 32
theme_override_styles/normal = SubResource("StyleBoxFlat_fycrg")
text = "How to convert moles to grams:

1.) Get the element/compound's molar mass
2.) Multiply it to the amount of moles you have
3.) Press record to get the mass of solid

Example:
5 mol H x 1.008g H =  5.04g H"
horizontal_alignment = 1
vertical_alignment = 1

